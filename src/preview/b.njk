---
layout: layouts/bare.njk
title: "Style B: The Gallery"
variant: b
permalink: /preview/b/
eleventyExcludeFromCollections: true
fonts: "https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Jost:wght@300;400;500&display=swap"
---
<style>
body{background:#0e0d0c;color:#e9e3d8;font-family:Jost,sans-serif;font-weight:300;font-size:17px;line-height:1.8}
.serif{font-family:"Cormorant Garamond",serif}
.g-nav{position:fixed;top:0;left:0;right:0;z-index:10;display:flex;justify-content:space-between;align-items:center;padding:22px 5vw;background:linear-gradient(#0e0d0ccc,transparent)}
.g-nav .mark{font-family:"Cormorant Garamond",serif;font-size:1.6rem;letter-spacing:.35em;text-transform:uppercase;text-decoration:none}
.g-nav ul{display:flex;gap:30px;list-style:none;font-size:.78rem;letter-spacing:.25em;text-transform:uppercase}
.g-nav ul a{text-decoration:none;opacity:.8}.g-nav ul a:hover{opacity:1;color:#d4a85a}
@media(max-width:700px){.g-nav ul{display:none}}
.g-hero{position:relative;height:100vh;min-height:620px;overflow:hidden}
.g-hero img{width:100%;height:100%;object-fit:cover;filter:brightness(.6)}
.g-hero::after{content:"";position:absolute;inset:0;background:linear-gradient(180deg,transparent 30%,#0e0d0cee 88%)}
.g-hero .cap,.g-hero .scroll{z-index:2}
.g-hero .cap{position:absolute;left:5vw;bottom:12vh;max-width:640px}
.g-hero .kick{font-size:.78rem;letter-spacing:.35em;text-transform:uppercase;color:#d4a85a}
.g-hero h1{font-family:"Cormorant Garamond",serif;font-weight:400;font-size:clamp(3.2rem,8vw,6.8rem);line-height:.95;margin:14px 0 22px}
.g-hero h1 i{color:#d4a85a}
.g-hero p{max-width:30em;color:#d8d0c2}
.scroll{position:absolute;right:5vw;bottom:12vh;font-size:.72rem;letter-spacing:.3em;text-transform:uppercase;writing-mode:vertical-rl;opacity:.7}
.g-sec{padding:120px 5vw}
.g-intro{display:grid;grid-template-columns:1fr 1.4fr;gap:8vw;align-items:center;max-width:1200px;margin:0 auto}
.g-intro img{width:100%;aspect-ratio:3/4;object-fit:cover;filter:grayscale(.15)}
.g-intro h2{font-family:"Cormorant Garamond",serif;font-weight:400;font-size:clamp(2.4rem,5vw,3.8rem);line-height:1.05;margin:10px 0 24px}
.g-intro a{color:#d4a85a;text-decoration:none;letter-spacing:.2em;text-transform:uppercase;font-size:.78rem;border-bottom:1px solid #d4a85a;padding-bottom:4px}
@media(max-width:800px){.g-intro{grid-template-columns:1fr}}
.room{max-width:1300px;margin:0 auto 110px}
.room-head{display:flex;justify-content:space-between;align-items:baseline;border-top:1px solid #3a3530;padding-top:22px;margin-bottom:34px;gap:20px;flex-wrap:wrap}
.room-head h3{font-family:"Cormorant Garamond",serif;font-weight:400;font-size:clamp(2rem,4vw,3rem)}
.room-head .num{font-size:.75rem;letter-spacing:.3em;color:#d4a85a}
.room-head .pr{font-size:.85rem;letter-spacing:.12em;text-transform:uppercase;color:#a99f90}
.wall{display:grid;grid-template-columns:repeat(auto-fill,minmax(250px,1fr));gap:34px}
.piece{cursor:zoom-in}
.piece img{width:100%;aspect-ratio:4/5;object-fit:cover;transition:filter .3s,transform .4s}
.piece:hover img{transform:scale(1.02)}
.piece .lbl{margin-top:14px;font-family:"Cormorant Garamond",serif;font-size:1.25rem;font-style:italic}
.piece .lbl small{display:block;font-family:Jost,sans-serif;font-style:normal;font-size:.75rem;letter-spacing:.18em;text-transform:uppercase;color:#a99f90;margin-top:4px}
.g-quote{text-align:center;max-width:860px;margin:0 auto;font-family:"Cormorant Garamond",serif;font-size:clamp(1.8rem,3.6vw,2.8rem);font-style:italic;line-height:1.3;color:#f1ead9}
.g-quote span{display:block;margin-top:24px;font-family:Jost;font-style:normal;font-size:.75rem;letter-spacing:.3em;text-transform:uppercase;color:#d4a85a}
.g-sym{max-width:1100px;margin:0 auto;columns:4 200px;column-gap:40px}
.g-sym div{break-inside:avoid;padding:12px 0;border-bottom:1px solid #2c2824}
.g-sym b{font-family:"Cormorant Garamond",serif;font-weight:500;font-size:1.2rem;display:block;color:#f1ead9}
.g-sym span{font-size:.9rem;color:#a99f90}
.g-contact{text-align:center;padding:140px 5vw 160px;border-top:1px solid #3a3530}
.g-contact h2{font-family:"Cormorant Garamond",serif;font-weight:400;font-size:clamp(2.6rem,6vw,4.6rem);margin:12px 0 18px}
.g-contact p{max-width:34em;margin:0 auto 34px;color:#cfc6b7}
.g-btn{display:inline-block;padding:16px 38px;border:1px solid #d4a85a;color:#d4a85a;text-decoration:none;letter-spacing:.25em;text-transform:uppercase;font-size:.8rem;margin:6px}
.g-btn:hover{background:#d4a85a;color:#0e0d0c}
.lb{position:fixed;inset:0;background:#000e;display:none;align-items:center;justify-content:center;flex-direction:column;gap:16px;z-index:50;padding:24px}
.lb.open{display:flex}.lb img{max-height:82vh;max-width:92vw}.lb p{font-family:"Cormorant Garamond",serif;font-size:1.5rem;font-style:italic}
</style>

<header class="g-nav"><a class="mark" href="#">Pictology</a>
<ul><li><a href="#collection">Collection</a></li><li><a href="#artist">The Artist</a></li><li><a href="#contact">Inquire</a></li></ul></header>

{% set hero = collections.featured[0] %}
<section class="g-hero">
  <img src="{{ hero.data.image }}" alt="{{ hero.data.image_alt }}">
  <div class="cap">
    <div class="kick">Hand-painted folk art · Brattleboro, Vermont</div>
    <h1 class="serif">Every egg<br>tells a <i>story.</i></h1>
    <p>{{ site.hero_text }}</p>
  </div>
  <div class="scroll">Scroll</div>
</section>

<section class="g-sec" id="artist">
  <div class="g-intro">
    <img src="{{ site.portrait }}" alt="{{ site.artist }}">
    <div>
      <div class="kick" style="font-size:.78rem;letter-spacing:.35em;text-transform:uppercase;color:#d4a85a">The Artist</div>
      <h2>{{ site.about_title }}</h2>
      <p style="margin-bottom:28px">{{ site.about_teaser }}</p>
      <a href="/about/">Read her story</a>
    </div>
  </div>
</section>

<section class="g-sec" id="collection" style="padding-top:40px">
  {% for c in categories %}
  <div class="room">
    <div class="room-head"><div><div class="num">0{{ loop.index }}</div><h3>{{ c.label }}</h3></div><div class="pr">{{ c.price }}</div></div>
    <div class="wall">
      {% for a in collections.artworks %}{% if c.key in a.data.categories %}
      <figure class="piece" data-img="{{ a.data.image }}" data-cap="{{ a.data.title }}"><img src="{{ a.data.image }}" alt="{{ a.data.image_alt }}" loading="lazy"><figcaption class="lbl">{{ a.data.title }}{% if a.data.availability %}<small>{{ a.data.availability }}</small>{% endif %}</figcaption></figure>
      {% endif %}{% endfor %}
    </div>
  </div>
  {% endfor %}
</section>

<section class="g-sec" style="background:#151311">
  <p class="g-quote">“Each line is drawn in hot wax, the egg goes into a dye bath, and the design builds up color by color.”<span>On the art of pysanky</span></p>
</section>

<section class="g-sec">
  <div class="room-head" style="max-width:1100px;margin:0 auto 30px"><h3>The language of symbols</h3><div class="pr">From Carole’s guide</div></div>
  <div class="g-sym">{% for s in symbols %}<div><b>{{ s[0] }}</b><span>{{ s[1] }}</span></div>{% endfor %}</div>
</section>

<section class="g-contact" id="contact">
  <div class="kick" style="font-size:.78rem;letter-spacing:.35em;text-transform:uppercase;color:#d4a85a">Inquiries & Commissions</div>
  <h2>{{ site.contact_title }}</h2>
  <p>{{ site.contact_blurb }}</p>
  {% if site.email %}<a class="g-btn" href="mailto:{{ site.email }}">Email Carole</a>{% endif %}
  <a class="g-btn" href="{{ site.facebook }}" target="_blank" rel="noopener">Facebook</a>
  <p style="margin-top:40px;font-size:.8rem;letter-spacing:.2em;text-transform:uppercase;color:#7d7468">© {{ "" | year }} {{ site.artist }} · {{ site.location }}</p>
</section>

<div class="lb" id="lb"><img id="lbi" alt=""><p id="lbc"></p></div>
<script>
const lb=document.getElementById('lb');
document.querySelectorAll('.piece').forEach(p=>p.onclick=()=>{document.getElementById('lbi').src=p.querySelector('img').src;document.getElementById('lbc').textContent=p.dataset.cap;lb.classList.add('open')});
lb.onclick=()=>lb.classList.remove('open');
</script>

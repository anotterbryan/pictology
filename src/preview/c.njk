---
layout: layouts/bare.njk
title: "Style C: The Holiday Shop"
variant: c
permalink: /preview/c/
eleventyExcludeFromCollections: true
fonts: "https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,600;0,800;1,600&family=Work+Sans:wght@400;500;600;700&display=swap"
---
<style>
:root{--pine:#1f4d3a;--pine-dk:#163a2b;--gold:#d9a441;--cream:#fdf9f1;--red:#b3312c;--ink:#22201c;--muted:#6c675e;--line:#e7dfcf}
body{background:var(--cream);color:var(--ink);font-family:"Work Sans",sans-serif;font-size:17px;line-height:1.6}
h1,h2,h3{font-family:"Playfair Display",serif}
.bar{background:var(--red);color:#fff;text-align:center;padding:10px 16px;font-weight:600;font-size:.95rem}
.bar a{color:#fff;text-decoration:underline}
.top{background:#fff;border-bottom:1px solid var(--line);position:sticky;top:0;z-index:10}
.top .in{max-width:1200px;margin:0 auto;padding:16px 24px;display:flex;align-items:center;justify-content:space-between;gap:16px}
.logo{font-family:"Playfair Display",serif;font-weight:800;font-size:1.7rem;color:var(--pine);text-decoration:none}
.logo small{display:block;font-family:"Work Sans";font-weight:500;font-size:.7rem;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.cta{background:var(--pine);color:#fff;text-decoration:none;padding:12px 20px;border-radius:8px;font-weight:700;font-size:.95rem;white-space:nowrap}
.hero{background:var(--pine);color:#fff}
.hero .in{max-width:1200px;margin:0 auto;padding:56px 24px;display:grid;grid-template-columns:1.1fr 1fr;gap:48px;align-items:center}
.hero h1{font-size:clamp(2.4rem,5vw,3.8rem);line-height:1.05;margin:10px 0 16px}
.hero h1 em{color:var(--gold)}
.hero p{color:#d9e6dd;font-size:1.1rem;max-width:30em}
.pill{display:inline-block;background:var(--gold);color:var(--pine-dk);font-weight:700;font-size:.8rem;padding:6px 12px;border-radius:999px;letter-spacing:.06em;text-transform:uppercase}
.hero .pics{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.hero .pics img{border-radius:12px;aspect-ratio:1;object-fit:cover;border:4px solid #fff}
.hero .pics img:first-child{grid-row:span 2;aspect-ratio:auto;height:100%}
@media(max-width:800px){.hero .in{grid-template-columns:1fr}}
.perks{max-width:1200px;margin:0 auto;padding:22px 24px;display:grid;grid-template-columns:repeat(4,1fr);gap:16px;text-align:center;font-weight:600;font-size:.92rem;color:var(--pine)}
.perks div{background:#fff;border:1px solid var(--line);border-radius:10px;padding:14px}
@media(max-width:800px){.perks{grid-template-columns:1fr 1fr}}
.shop{max-width:1200px;margin:0 auto;padding:30px 24px 80px}
.shop h2{font-size:2.2rem;margin-bottom:6px}
.shop .sub{color:var(--muted);margin-bottom:20px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:26px;position:sticky;top:76px;background:var(--cream);padding:10px 0;z-index:5}
.tabs button{font:inherit;font-weight:600;border:2px solid var(--pine);background:#fff;color:var(--pine);border-radius:8px;padding:9px 16px;cursor:pointer}
.tabs button.on{background:var(--pine);color:#fff}
.tabs button small{opacity:.75;font-weight:500;margin-left:4px}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:22px}
.card{background:#fff;border:1px solid var(--line);border-radius:14px;overflow:hidden;display:flex;flex-direction:column}
.card img{aspect-ratio:1;object-fit:cover;width:100%}
.card .b{padding:14px 16px 16px;display:flex;flex-direction:column;flex:1}
.card h3{font-size:1.1rem;margin-bottom:4px}
.card p{font-size:.88rem;color:var(--muted);flex:1}
.card .row{display:flex;justify-content:space-between;align-items:center;margin-top:12px;gap:8px}
.price{font-weight:700;color:var(--red);font-size:1.05rem}
.ask{font-size:.82rem;font-weight:700;color:var(--pine);border:1.5px solid var(--pine);border-radius:6px;padding:7px 10px;text-decoration:none;white-space:nowrap}
.ask:hover{background:var(--pine);color:#fff}
.card.hide{display:none}
.badge{position:absolute;margin:10px;background:var(--gold);color:var(--pine-dk);font-weight:700;font-size:.72rem;padding:4px 8px;border-radius:6px;text-transform:uppercase}
.meet{background:#fff;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}
.meet .in{max-width:1000px;margin:0 auto;padding:60px 24px;display:grid;grid-template-columns:200px 1fr;gap:40px;align-items:center}
.meet img{border-radius:50%;aspect-ratio:1;object-fit:cover;border:6px solid var(--gold)}
.meet h2{font-size:2rem;margin-bottom:10px}
.meet a{color:var(--red);font-weight:700}
@media(max-width:700px){.meet .in{grid-template-columns:1fr;text-align:center}.meet img{max-width:180px;margin:0 auto}}
.how{max-width:1000px;margin:0 auto;padding:60px 24px}
.how h2{font-size:2rem;text-align:center;margin-bottom:26px}
.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;counter-reset:s}
.steps div{background:#fff;border:1px solid var(--line);border-radius:14px;padding:22px}
.steps div::before{counter-increment:s;content:counter(s);display:inline-grid;place-items:center;width:34px;height:34px;border-radius:50%;background:var(--gold);color:var(--pine-dk);font-weight:800;margin-bottom:10px}
.steps b{display:block;font-size:1.05rem;margin-bottom:4px}
@media(max-width:700px){.steps{grid-template-columns:1fr}}
.foot{background:var(--pine-dk);color:#cfdcd3;text-align:center;padding:40px 24px 90px;font-size:.92rem}
.foot b{color:#fff}
</style>

<div class="bar">✨ Collaged cards are $7 each, or 4 for $25. <a href="#shop" data-go="cards">Pick your favorites</a></div>
<header class="top"><div class="in">
  <a class="logo" href="#">Pictology<small>Handmade by Carole · Vermont</small></a>
  <a class="cta" href="mailto:{{ site.email }}?subject=Pictology%20order">Email to order</a>
</div></header>

<section class="hero"><div class="in">
  <div>
    <span class="pill">Handmade holiday gifts</span>
    <h1>Gifts painted &amp; made <em>by hand</em> in Vermont.</h1>
    <p>{{ site.hero_text }}</p>
  </div>
  <div class="pics">
    <img src="/images/art/hero-eggs.jpg" alt="Pysanky eggs">
    <img src="/images/art/card-sheep-night.jpg" alt="Collaged card">
    <img src="/images/art/card-birch.jpg" alt="Collaged card">
  </div>
</div></section>

<div class="perks">
  <div>🥚 One of a kind</div><div>🎨 Hand painted &amp; handmade</div><div>💌 Cards 4 for $25</div><div>🎁 Custom orders welcome</div>
</div>

<section class="shop" id="shop">
  <h2>Shop the collection</h2>
  <p class="sub">See something you love? Tap “Ask about this” and Carole will get back to you.</p>
  <div class="tabs">
    <button class="on" data-f="all">Everything</button>
    {% for c in categories %}<button data-f="{{ c.key }}">{{ c.label }}<small>{{ c.price | replace(" · New!", "") }}</small></button>{% endfor %}
  </div>
  <div class="grid">
    {% for a in collections.artworks %}
    <article class="card" data-c="{{ a.data.categories | join(' ') }}">
      {% if 'New' in a.data.availability %}<span class="badge">New</span>{% endif %}
      <img src="{{ a.data.image }}" alt="{{ a.data.image_alt }}" loading="lazy">
      <div class="b"><h3>{{ a.data.title }}</h3><p>{{ a.data.caption }}</p>
      <div class="row"><span class="price">{{ (a.data.availability | replace(" · New!", "")) or "Ask for price" }}</span>
      <a class="ask" href="mailto:{{ site.email }}?subject={{ ('Pictology: ' + a.data.title) | urlencode }}">Ask about this</a></div></div>
    </article>
    {% endfor %}
  </div>
</section>

<section class="meet"><div class="in">
  <img src="{{ site.portrait }}" alt="{{ site.artist }}">
  <div><h2>Meet Carole</h2><p>{{ site.about_teaser }}</p><p style="margin-top:12px"><a href="/about/">Read her story →</a></p></div>
</div></section>

<section class="how">
  <h2>How to order</h2>
  <div class="steps">
    <div><b>Pick your favorites</b>Browse the shop and tap “Ask about this” on anything you love.</div>
    <div><b>Carole emails you back</b>She’ll confirm it’s available and work out payment and pickup or shipping.</div>
    <div><b>Enjoy (or gift it!)</b>Every egg comes boxed with a sheet explaining its symbols.</div>
  </div>
</section>

<footer class="foot"><b>Pictology</b> · Handmade by {{ site.artist }} in {{ site.location }}<br>{{ site.email }} · <a href="{{ site.facebook }}" style="color:#fff">Facebook</a></footer>

<script>
const btns=[...document.querySelectorAll('.tabs button')],cards=[...document.querySelectorAll('.card')];
function f(k){btns.forEach(b=>b.classList.toggle('on',b.dataset.f===k));cards.forEach(c=>c.classList.toggle('hide',k!=='all'&&!c.dataset.c.split(' ').includes(k)))}
btns.forEach(b=>b.onclick=()=>f(b.dataset.f));
document.querySelectorAll('[data-go]').forEach(a=>a.addEventListener('click',()=>f(a.dataset.go)));
</script>

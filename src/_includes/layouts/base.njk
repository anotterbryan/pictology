<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
{%- set pageTitle = (title + " | " + site.name) if title else (site.name + " | Folk Art by " + site.artist) -%}
{%- set pageDesc = summary or site.meta_description -%}
<title>{{ pageTitle }}</title>
<meta name="description" content="{{ pageDesc }}">
<link rel="canonical" href="{{ site.url }}{{ page.url }}">
<meta property="og:title" content="{{ pageTitle }}">
<meta property="og:description" content="{{ pageDesc }}">
<meta property="og:type" content="website">
<meta property="og:image" content="{{ site.url }}/images/art/hero-eggs.jpg">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="icon" href="/icons/favicon.ico" sizes="48x48">
<link rel="apple-touch-icon" href="/icons/apple-touch-icon.png">
<link rel="manifest" href="/site.webmanifest">
<meta name="theme-color" content="#c0392b">
<meta name="apple-mobile-web-app-title" content="Pictology">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,500;0,600;0,700;1,500;1,600&family=Nunito+Sans:wght@400;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/style.css">
</head>
<body>
<div class="band" aria-hidden="true"></div>
<header><div class="wrap"><nav>
  <a class="logo" href="/">Picto<span>logy</span></a>
  <ul class="links">
    <li><a href="/#gallery">Work</a></li>
        <li><a href="/about/">About</a></li>
    <li><a href="/#contact">Contact</a></li>
  </ul>
</nav></div></header>
<main id="top">
{{ content | safe }}
</main>
<div class="band" aria-hidden="true"></div>
<footer><b>{{ site.name }}</b> · Folk art by {{ site.artist }} · {{ site.location }}<br>All artwork © {{ "" | year }} {{ site.artist }}. Please don’t reproduce without permission.</footer>
{% if page.url == "/" %}
<style>.switcher{position:fixed;left:50%;bottom:16px;transform:translateX(-50%);z-index:99;background:#111;color:#fff;border-radius:999px;padding:8px 10px;display:flex;gap:6px;align-items:center;font:600 13px/1 system-ui,sans-serif;box-shadow:0 10px 30px rgba(0,0,0,.3)}.switcher span{padding:0 6px;opacity:.7}.switcher a{text-decoration:none;padding:8px 12px;border-radius:999px;background:#2a2a2a;color:#fff}.switcher a.on{background:#fff;color:#111}</style>
<nav class="switcher" aria-label="Compare styles"><span>Style</span><a href="/" class="on">A</a><a href="/preview/b/">B</a><a href="/preview/c/">C</a><a href="/preview/d/">D</a><a href="/choose/">All 4</a></nav>
{% endif %}
<script src="/js/site.js"></script>
</body>
</html>
